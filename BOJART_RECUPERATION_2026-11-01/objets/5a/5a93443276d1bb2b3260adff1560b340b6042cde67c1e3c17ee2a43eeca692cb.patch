+            db.execute('PRAGMA busy_timeout=10000')
+            db.execute('PRAGMA foreign_keys=ON')
+            with db:
+                yield db
+        finally:
+            db.close()
 
     def project_revision(self, project='BOJ-PILOTE-001'):
         with self.connect() as db:
