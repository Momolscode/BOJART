flowchart TD
  MIC["Parler · micro réservé · pause ou fin manuelle"] --> ASR["Transcription locale · poids à configurer"]
  KEY["Commande écrite"] --> SNAP["Contexte figé · dossier · révision · sélection"]
  MIC --> SNAP
  ASR --> ROUTE
  SNAP --> ROUTE
  subgraph LG["LangGraph persistant · code exécuté"]
    ROUTE{"route · ordre connu ?"}
    ROUTE -->|oui| LOCAL["Règles locales · intention déclarée"]
    ROUTE -->|non| JEV["Jev facultatif · texte et choix bornés"]
    JEV --> GUARD
    LOCAL --> GUARD["guard · contexte, délai et fichiers"]
    GUARD -->|confirmation requise| ASK["Proposition visuelle conservée"]
    ASK --> CONFIRM["Confirme cet affichage · voix ou bouton"]
    CONFIRM -->|même proposition| ROUTE
    GUARD -->|valide| DISPATCH["dispatch · plan visuel conservé"]
    GUARD -->|périmé ou refusé| RECEIPT["receipt · état et motif"]
    DISPATCH --> RECEIPT
  end
  DISPATCH --> VIEWS["Trois vues · atelier, pilotage, création"]
  VIEWS --> ACK["Rendu puis trois reçus · reprise partielle"]
  ACK --> REPLY["Retour écrit ou parlé local"]
  RECEIPT --> REPLY
  ROUTE <--> DB[("Journal, checkpoints et sauvegardes")]
  DISPATCH -.-> FUTURE["Découpe, imprimantes, publication · à raccorder"]
  classDef local fill:#183d33,stroke:#70ceb2,color:#f6fffc
  classDef setup fill:#493517,stroke:#e9b361,color:#fff5df
  classDef future fill:#302b3b,stroke:#b49acb,color:#f5efff,stroke-dasharray:6 5
  class SNAP,ROUTE,LOCAL,GUARD,DISPATCH,RECEIPT,ASK,CONFIRM,VIEWS,ACK,DB,KEY local
  class MIC,ASR,JEV,REPLY setup
  class FUTURE future
