flowchart TD
  MIC["Microphone unique · bouton Parler"] --> ASR["Transcription locale · modèle à configurer"]
  TXT["Commande écrite"] --> TURN["Tour figé · projet · révision · référence"]
  ASR --> TURN
  TURN --> ROUTE{"LangGraph · ordre connu ?"}
  ROUTE -->|oui| RULE["Règles locales"]
  ROUTE -->|non| JEV["Jev facultatif · texte et choix bornés"]
  JEV --> HUMAN["Proposition à confirmer ou à préciser"]
  RULE --> GUARD["Contrôles · contexte · délai · modèle sélectionné"]
  HUMAN --> GUARD
  GUARD -->|valide| DISPATCH["Commande visuelle persistante"]
  GUARD -->|périmé ou annulé| STOP["Arrêt du tour · motif visible"]
  DISPATCH --> VIEW["Envoi immédiat · vues atelier, pilotage, création"]
  VIEW --> ACK["Rendu vérifié · reçu du navigateur"]
  ACK --> FEEDBACK["État visible · réponse parlée locale facultative"]
  TURN <--> DB[("Journal et checkpoints SQLite")]
  DB --> BACKUP["Sauvegarde globale · restauration contrôlée"]
  CANCEL["Interrompre · prise et réponse vocale"] --> STOP
  CANCEL --> FEEDBACK
  classDef ready fill:#16372f,stroke:#68c8ac,color:#f4fff9
  classDef setup fill:#3b2d13,stroke:#edba60,color:#fff8e9
  class MIC,TXT,TURN,ROUTE,RULE,GUARD,DISPATCH,VIEW,ACK,DB,BACKUP,STOP,CANCEL ready
  class ASR,JEV,HUMAN,FEEDBACK setup
