new file mode 100644
index 0000000..b216408
--- /dev/null
+++ b/docs/evidence/growth-2026-10-31/recipe_browser_preview.py
@@ -0,0 +1,45 @@
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+import json,time
+D=Path('/mnt/data/BOJART_SEO_PUBLICATION_2026-10-31'); checks=[]
+def check(name,ok):
+    assert ok,name
+    checks.append(name)
+with sync_playwright() as p:
+    b=p.chromium.launch(headless=True,executable_path='/usr/bin/chromium',args=['--no-sandbox']);page=b.new_page(viewport={'width':1440,'height':1080},device_scale_factor=1)
+    external=[];errors=[]
+    page.on('request',lambda r:external.append(r.url) if r.url.startswith('http') else None)
+    page.on('pageerror',lambda e:errors.append(str(e)))
+    page.set_content((D/'APERCU_SEO_PUBLICATIONS.html').read_text(),wait_until='load')
+    check('Comptes TikTok exacts et autres profils inconnus',page.locator('#account option').count()==5 and page.locator('#account option').nth(1).inner_text().endswith('@boj.art3d'))
+    check('Huit passages du vrai catalogue M03',page.locator('input[name="segment"]').count()==8)
+    check('Passage rejeté désactivé',page.locator('input[value="vfx-2d"]').is_disabled())
+    check('Sélection ensemble et visage',page.locator('input[value="ensemble"]').is_checked() and page.locator('input[value="visage"]').is_checked())
+    page.get_by_role('button',name='Préparer le brouillon').click()
+    page.wait_for_selector('#packet',state='visible')
+    check('Légende du brouillon réel', 'Du regard' in page.locator('#caption').inner_text())
+    check('Quatre hashtags explicables',page.locator('#tags .tag').count()==4 and '#BOJART' in page.locator('#tags').inner_text())
+    check('Aucune prétendue publication', 'NON PUBLIÉ' in page.locator('#target').inner_text())
+    check('Contrôle de droits visible','Droits de diffusion' in page.locator('#blockers').inner_text())
+    page.get_by_role('button',name='Relire les sources').click()
+    check('État précalculé et absence connecteur', 'moment de la création' in page.locator('#feedback').inner_text())
+    with page.expect_download() as dl:
+        page.get_by_role('button',name='Exporter le brouillon JSON').click()
+    d=json.loads(Path(dl.value.path()).read_text())
+    check('Export JSON non publié',not d['delivery']['published'] and not d['live_publish_supported'])
+    page.locator('summary').click();check('Raisons accessibles',page.locator('#reasons li').count()==4)
+    page.screenshot(path=str(D/'BOJART_SEO_Publication_Apercu.png'),full_page=True)
+    page.select_option('#topic','painting');page.get_by_role('button',name='Préparer le brouillon').click()
+    check('Combinaison non précalculée signalée','exemple vérifié' in page.locator('#feedback').inner_text())
+    check('Pas de vieux brouillon après changement',not page.locator('#packet').is_visible())
+    page.select_option('#topic','sculpture');page.get_by_role('button',name='Préparer le brouillon').focus();page.keyboard.press('Enter')
+    check('Validation au clavier',page.locator('#packet').is_visible())
+    page.set_viewport_size({'width':390,'height':844});page.emulate_media(reduced_motion='reduce')
+    check('Pas de dépassement horizontal mobile',page.evaluate('document.documentElement.scrollWidth <= innerWidth'))
+    check('Bouton mobile accessible',page.get_by_role('button',name='Préparer le brouillon').is_visible())
+    page.screenshot(path=str(D/'BOJART_SEO_Publication_Mobile.png'),full_page=True)
+    check('Aucun appel HTTP externe',not external)
+    check('Aucune erreur JavaScript',not errors)
+    b.close()
+(D/'TESTS_INTERFACE.json').write_text(json.dumps({'status':'passed','count':len(checks),'checks':checks,'mode':'Chromium, HTML autonome chargé avec set_content ; pas de connexion à localhost ou aux réseaux sociaux'},ensure_ascii=False,indent=2))
+print(len(checks),'contrôles réussis')
diff --git a/knowledge/growth/AUDIT_SKILLS.md b/knowledge/growth/AUDIT_SKILLS.md
new file mode 100644
index 0000000..bc9715c
--- /dev/null
+++ b/knowledge/growth/AUDIT_SKILLS.md
@@ -0,0 +1,16 @@
+# Skills étudiés et installation réelle
+
+Catalogue de découverte : Skills.sh/coreyhaines31/marketingskills.
+Commit observé par le connecteur GitHub : `5ffe077d2e59486d91c5ccaecbd74b6973c32308` (version pack annoncée 2.14.0). Licence MIT lue.
+
+- `social` : cœur lu ; la sortie complète et ses références annexes n’ont pas été auditées intégralement.
+- `seo-audit` : lignes 1–170 lues.
+- `ai-seo` : lignes 1–130 lues.
+- Aucune exécution de `npx`, hook, script ou téléchargement de dépendances du pack.
+- Le téléchargement complet du snapshot n’a pas abouti dans cet environnement ; aucune installation tierce complète n’est revendiquée.
+
+Décision : six skills BOJ.ART originaux et contextualisés sont réellement installés dans `.claude/skills` et `.agents/skills` de la copie locale. Ils reprennent des méthodes générales, mais pas les quotas arbitraires, les statistiques vendor ou les mécanismes d’outreach proposés ailleurs. Manifestes SHA-256 joints. La présence des fichiers ne prouve pas leur invocation par un LLM ; leur intégration à l’agent local sera testée sur la tour.
+
+Écart corrigé : « seo-audit » n’est pas la préparation TikTok. Le site, le packaging des vidéos, la recherche sociale, les droits et l’exécution disposent de responsabilités séparées.
+
+Sécurité : aucun secret, aucun code tiers installé, pas d’auto-update. Comparer une future révision avant adoption. Les sources et sources manquantes sont explicitement indiquées.
